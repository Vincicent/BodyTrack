# build the app and run the Maestro flows (.maestro/) on every pull request to main
name: e2e
on:
  pull_request:
    branches: ['main']
jobs:
  build_android:
    type: build
    params:
      platform: android
      profile: e2e-test # eas.json: an unsigned universal APK, so it runs on the cloud emulator
  maestro_android:
    needs: [build_android]
    type: maestro
    params:
      build_id: ${{ needs.build_android.outputs.build_id }}
      flow_path: ['.maestro']
