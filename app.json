{
  "expo": {
    "name": "BodyTrack",
    "slug": "body-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bodytrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vincicent.bodytrack",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.vincicent.bodytrack",
      "adaptiveIcon": {
        "backgroundColor": "#115E59",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#115E59",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0F19",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BodyTrack uses your photos to attach progress pictures to your entries."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
