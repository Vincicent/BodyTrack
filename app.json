{
  "expo": {
    "name": "BodyTrack",
    "slug": "body-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bodytrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vincicent.bodytrack",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.vincicent.bodytrack",
      "adaptiveIcon": {
        "backgroundColor": "#115E59",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#115E59",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0F19",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BodyTrack uses your photos to attach progress pictures to your entries."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "BodyTrack uses the camera to scan the barcode of food products.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      ["@sentry/react-native", { "organization": "vincicent", "project": "body-track" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3337ff3e-06dd-443f-a4f6-e5194695475a"
      }
    },
    "owner": "vincicent",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3337ff3e-06dd-443f-a4f6-e5194695475a"
    }
  }
}
